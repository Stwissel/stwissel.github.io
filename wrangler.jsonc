{
  // /why "stwissel-github-io": this is the Worker the zone's custom domains
  // (wissel.net, www.wissel.net) are actually bound to. This file previously said
  // "wissel-net", which deployed a DUPLICATE Worker that nothing routed to, while
  // the live site ran older identical code under this name. Verified against
  // GET /accounts/{id}/workers/domains. Do not rename without moving the domains.
  "name": "stwissel-github-io",
  // /why: these ten custom domains are attached to this Worker in Cloudflare. They
  // are declared here so the local config matches reality — without them, every
  // `wrangler deploy` warns that it will override the remote configuration, which
  // trains you to click past a warning that one day will be real.
  // NOTE: wrangler offers to write the remote config back into this file. Do NOT
  // accept that: it also writes the `PushUser` var, a Pushover credential, and this
  // repository is PUBLIC. Nothing in worker/index.js reads that var.
  "routes": [
    { "pattern": "wissel.net", "zone_name": "wissel.net", "custom_domain": true },
    { "pattern": "www.wissel.net", "zone_name": "wissel.net", "custom_domain": true },
    { "pattern": "wissel.asia", "zone_name": "wissel.asia", "custom_domain": true },
    { "pattern": "www.wissel.asia", "zone_name": "wissel.asia", "custom_domain": true },
    { "pattern": "notessensei.com", "zone_name": "notessensei.com", "custom_domain": true },
    { "pattern": "www.notessensei.com", "zone_name": "notessensei.com", "custom_domain": true },
    { "pattern": "wissel.ph", "zone_name": "wissel.ph", "custom_domain": true },
    { "pattern": "www.wissel.ph", "zone_name": "wissel.ph", "custom_domain": true },
    { "pattern": "wissel.sg", "zone_name": "wissel.sg", "custom_domain": true },
    { "pattern": "www.wissel.sg", "zone_name": "wissel.sg", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "services": [{ "binding": "COMMENTS", "service": "blog-comments" }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
