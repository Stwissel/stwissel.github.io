{
  // /why "stwissel-github-io": this is the Worker the zone's custom domains
  // (wissel.net, www.wissel.net) are actually bound to. This file previously said
  // "wissel-net", which deployed a DUPLICATE Worker that nothing routed to, while
  // the live site ran older identical code under this name. Verified against
  // GET /accounts/{id}/workers/domains. Do not rename without moving the domains.
  "name": "stwissel-github-io",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "services": [{ "binding": "COMMENTS", "service": "blog-comments" }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
